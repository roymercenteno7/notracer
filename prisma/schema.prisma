generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  createdAt    DateTime @default(now())
  links        Link[]
}

model Link {
  id          String    @id @default(cuid())
  slug        String    @unique
  originalUrl String
  cleanedUrl  String
  userId      String?
  createdAt   DateTime  @default(now())
  clicks      Int       @default(0)
  expiresAt   DateTime?
  user        User?     @relation(fields: [userId], references: [id])
}
