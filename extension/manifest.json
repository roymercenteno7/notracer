{
    "manifest_version": 3,
    "name": "NoTracer Sentinela",
    "version": "0.1.0",
    "description": "Real-time tracking link detector and cleaner.",
    "permissions": [
        "storage",
        "cookies"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "action": {
        "default_title": "NoTracer Sentinela"
    },
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "scripts/sentinela.js"
            ],
            "css": [
                "styles/sentinela.css"
            ]
        }
    ],
    "icons": {
        "192": "icons/icon192.png"
    }
}